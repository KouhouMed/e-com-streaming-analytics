# ── Kafka (KRaft) ──────────────────────────────────────────────────────────────
# Port exposed to the host machine
KAFKA_EXTERNAL_PORT=9092
# Port used for broker-to-broker / container-to-container traffic
KAFKA_INTERNAL_PORT=29092
# Pre-generated KRaft cluster ID (run: docker run --rm confluentinc/cp-kafka:7.6.0 kafka-storage random-uuid)
CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

# Topic names — referenced by producer, consumer, and aggregator
KAFKA_TOPIC_CLICKSTREAM=ecom.clickstream
KAFKA_TOPIC_ORDERS=ecom.orders
KAFKA_TOPIC_PAGEVIEWS=ecom.pageviews
KAFKA_TOPIC_INVENTORY=ecom.inventory

# ── Producer (Day 2) ───────────────────────────────────────────────────────────
# Used when running generator.py directly on the host (not via docker compose)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EVENTS_PER_SECOND=5
KAFKA_STARTUP_RETRIES=10
KAFKA_STARTUP_RETRY_DELAY=3

# ── Spark (Day 3) ──────────────────────────────────────────────────────────────
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2
# How often each streaming micro-batch fires (seconds)
TRIGGER_INTERVAL_SECS=10

# ── Windowed Aggregations (Day 4) ──────────────────────────────────────────────
# WATERMARK_DURATION controls how long Spark waits for late events before
# finalising a window.  Lower it in development for faster console feedback.
WATERMARK_DURATION=10 minutes
REVENUE_WINDOW_DURATION=1 minute
ACTIVITY_WINDOW_DURATION=5 minutes
ACTIVITY_SLIDE_DURATION=1 minute

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host-side port for connecting from your machine (psql, DBeaver, etc.)
# Internal container-to-container traffic still uses postgres:5432
POSTGRES_EXTERNAL_PORT=5433
POSTGRES_USER=ecom_user
POSTGRES_PASSWORD=ecom_pass
POSTGRES_DB=ecom_db

# ── Streamlit Dashboard (Day 6) ────────────────────────────────────────────────
DASHBOARD_PORT=8501
# Page auto-refresh interval in milliseconds
DASHBOARD_REFRESH_MS=3000
# How far back to pull revenue windows (minutes)
DASHBOARD_LOOKBACK_MINUTES=60
# Sliding window size for the category bar chart (minutes)
DASHBOARD_CATEGORY_WINDOW=30
