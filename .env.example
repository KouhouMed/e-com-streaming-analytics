# ── Kafka (KRaft) ──────────────────────────────────────────────────────────────
# Port exposed to the host machine
KAFKA_EXTERNAL_PORT=9092
# Port used for broker-to-broker / container-to-container traffic
KAFKA_INTERNAL_PORT=29092
# Pre-generated KRaft cluster ID (run: docker run --rm confluentinc/cp-kafka:7.6.0 kafka-storage random-uuid)
CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

# Topic names — referenced by producer, consumer, and aggregator
KAFKA_TOPIC_ORDERS=ecom.orders
KAFKA_TOPIC_PAGEVIEWS=ecom.pageviews
KAFKA_TOPIC_INVENTORY=ecom.inventory

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ecom_user
POSTGRES_PASSWORD=ecom_pass
POSTGRES_DB=ecom_db
